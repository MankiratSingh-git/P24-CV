# ==============================================================================
# Project Specific Exclusions (Large Files, Datasets, Checkpoints, Clones)
# ==============================================================================

# Datasets and Archives (6.5GB+ UCF-101 videos and archives)
data/*
!data/splits/
*.zip
*.tar
*.tar.gz
*.avi
*.mp4
*.mkv

# Model Checkpoints and Weights (>250MB per model)
checkpoints/
*.pth
*.pt
*.ckpt
*.bin
*.onnx

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# External Reference Cloned Repositories
ref_*/

# Large PDF documents
*.pdf

# Scratch, Dumped Logs, and Temporary Extraction Files
scratch_*.txt
paper_results_pages.txt
tables_extracted.txt
f2_paper_extracted.txt
*.log

# ==============================================================================
# Standard Python & OS Ignores
# ==============================================================================
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# VS Code / JetBrains / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
